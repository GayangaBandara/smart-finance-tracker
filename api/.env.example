# Example .env for Gemini Insights API
# Create a local .env file with your real Gemini API key. Do NOT commit your real key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
PORT=5001

# Notes:
# - Set the GEMINI_API_KEY in your environment or a local .env file before starting the API server.
# - For development, you can run: `cd api && npm start` (ensure you have node and dependencies installed).
